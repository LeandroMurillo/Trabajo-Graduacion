# Copiar como .env.production y reemplazar todos los valores.
COMPOSE_PROJECT_NAME=trabajo-graduacion

# Puertos del host. En AWS, los target groups del ALB apuntan a estos puertos.
PUBLIC_PORT=80
ADMIN_PORT=8080

# Orígenes públicos exactos, separados por coma y sin barra final.
APP_ORIGINS=https://empleos.example.com,https://admin-empleos.example.com

DB_ROOT_PASSWORD=replace-with-a-long-random-password
DB_USER=proyecto_app
DB_PASSWORD=replace-with-another-long-random-password

JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# JSON minificado en una sola línea. No usar la credencial que estuvo en Git.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace","private_key":"-----BEGIN PRIVATE KEY-----\nreplace\n-----END PRIVATE KEY-----\n","client_email":"replace@example.iam.gserviceaccount.com"}

# Estas variables se incorporan al frontend y, por diseño de Firebase, son públicas.
VITE_FIREBASE_API_KEY=replace
VITE_FIREBASE_AUTH_DOMAIN=replace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace
VITE_FIREBASE_STORAGE_BUCKET=replace.firebasestorage.app
VITE_FIREBASE_MESSAGE_SENDER_ID=replace
VITE_FIREBASE_APP_ID=replace
